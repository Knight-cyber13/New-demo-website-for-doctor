<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="800" height="600">
  <defs>
    <linearGradient id="c1grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F0F9FF"/>
      <stop offset="100%" stop-color="#E0F2FE"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#c1grad)"/>
  <!-- Room Floor -->
  <polygon points="0,480 800,480 800,600 0,600" fill="#E2E8F0"/>
  <!-- Window with natural light -->
  <rect x="80" y="80" width="220" height="240" rx="8" fill="#FFFFFF" stroke="#94A3B8" stroke-width="4"/>
  <line x1="190" y1="80" x2="190" y2="320" stroke="#94A3B8" stroke-width="4"/>
  <line x1="80" y1="200" x2="300" y2="200" stroke="#94A3B8" stroke-width="4"/>
  <!-- Doctor Desk -->
  <rect x="360" y="320" width="360" height="170" rx="6" fill="#FFFFFF" stroke="#CBD5E1" stroke-width="3"/>
  <rect x="380" y="340" width="100" height="70" rx="4" fill="#0F172A"/>
  <rect x="420" y="410" width="20" height="15" fill="#64748B"/>
  <rect x="400" y="425" width="60" height="5" rx="2" fill="#64748B"/>
  <!-- Stethoscope on desk -->
  <circle cx="530" cy="380" r="15" fill="none" stroke="#2563EB" stroke-width="4"/>
  <path d="M530 395 C530 420, 560 420, 560 395" fill="none" stroke="#2563EB" stroke-width="4"/>
  <!-- Ergonomic Doctor Chair -->
  <rect x="520" y="220" width="90" height="120" rx="16" fill="#2563EB"/>
  <!-- Examination Bed -->
  <rect x="80" y="380" width="240" height="90" rx="10" fill="#38BDF8"/>
  <rect x="80" y="380" width="70" height="90" rx="10" fill="#2563EB"/>
  <rect x="85" y="470" width="15" height="40" fill="#64748B"/>
  <rect x="290" y="470" width="15" height="40" fill="#64748B"/>
  <!-- Sanitized & Clean Badge -->
  <g transform="translate(480, 60)">
    <rect width="260" height="56" rx="28" fill="#FFFFFF" filter="drop-shadow(0 4px 6px rgba(0,0,0,0.06))"/>
    <circle cx="30" cy="28" r="16" fill="#DCFCE7"/>
    <path d="M24 28 L28 32 L36 24" stroke="#16A34A" stroke-width="2.5" stroke-linecap="round" fill="none"/>
    <text x="56" y="26" font-family="'Poppins', sans-serif" font-weight="600" font-size="14" fill="#0F172A">Consultation Chamber</text>
    <text x="56" y="42" font-family="'Inter', sans-serif" font-size="11" fill="#64748B">Private, Sanitized &amp; Modern</text>
  </g>
</svg>
