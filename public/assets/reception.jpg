<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="800" height="600">
  <defs>
    <linearGradient id="recGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#EFF6FF"/>
      <stop offset="100%" stop-color="#DBEAFE"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#recGrad)"/>
  <!-- Floor -->
  <polygon points="0,460 800,460 800,600 0,600" fill="#E2E8F0"/>
  <!-- Curved Modern Reception Counter -->
  <path d="M150 460 Q400 380 650 460 L650 340 Q400 270 150 340 Z" fill="#2563EB"/>
  <path d="M150 340 Q400 270 650 340 L650 320 Q400 250 150 320 Z" fill="#38BDF8"/>
  <!-- Receptionist Computer & Desk Items -->
  <rect x="360" y="240" width="80" height="60" rx="4" fill="#0F172A"/>
  <rect x="395" y="300" width="10" height="15" fill="#64748B"/>
  <!-- Logo on Back Wall -->
  <circle cx="400" cy="140" r="40" fill="#FFFFFF" filter="drop-shadow(0 4px 6px rgba(0,0,0,0.06))"/>
  <path d="M400 120 V160 M380 140 H420" stroke="#2563EB" stroke-width="8" stroke-linecap="round"/>
  <!-- Badge -->
  <g transform="translate(480, 80)">
    <rect width="270" height="60" rx="30" fill="#FFFFFF" filter="drop-shadow(0 4px 6px rgba(0,0,0,0.06))"/>
    <circle cx="32" cy="30" r="18" fill="#DCFCE7"/>
    <path d="M25 30 L30 35 L40 24" stroke="#16A34A" stroke-width="3" fill="none"/>
    <text x="60" y="28" font-family="'Poppins', sans-serif" font-weight="600" font-size="13" fill="#0F172A">Helpful Reception Desk</text>
    <text x="60" y="44" font-family="'Inter', sans-serif" font-size="11" fill="#64748B">Instant Check-In &amp; Inquiries</text>
  </g>
</svg>
