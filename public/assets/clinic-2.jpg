<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="800" height="600">
  <defs>
    <linearGradient id="c2grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F8FAFC"/>
      <stop offset="100%" stop-color="#EFF6FF"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#c2grad)"/>
  <!-- Floor -->
  <polygon points="0,450 800,450 800,600 0,600" fill="#E2E8F0"/>
  <!-- Waiting Chairs -->
  <g transform="translate(100, 360)">
    <rect x="0" y="0" width="80" height="80" rx="12" fill="#2563EB"/>
    <rect x="95" y="0" width="80" height="80" rx="12" fill="#2563EB"/>
    <rect x="190" y="0" width="80" height="80" rx="12" fill="#2563EB"/>
    <rect x="285" y="0" width="80" height="80" rx="12" fill="#2563EB"/>
  </g>
  <!-- Water Dispenser & Plants -->
  <rect x="700" y="280" width="40" height="170" rx="6" fill="#CBD5E1"/>
  <circle cx="720" cy="260" r="25" fill="#38BDF8" opacity="0.7"/>
  <!-- Wall Art -->
  <rect x="180" y="100" width="220" height="130" rx="8" fill="#FFFFFF" stroke="#CBD5E1" stroke-width="4"/>
  <circle cx="290" cy="165" r="35" fill="#DCFCE7"/>
  <path d="M275 165 C285 145, 295 185, 305 165" stroke="#16A34A" stroke-width="4" fill="none"/>
  <!-- Waiting Area Badge -->
  <g transform="translate(460, 80)">
    <rect width="280" height="60" rx="30" fill="#FFFFFF" filter="drop-shadow(0 4px 6px rgba(0,0,0,0.06))"/>
    <circle cx="32" cy="30" r="18" fill="#E0F2FE"/>
    <path d="M25 30 L39 30 M32 23 L32 37" stroke="#2563EB" stroke-width="3" stroke-linecap="round"/>
    <text x="60" y="28" font-family="'Poppins', sans-serif" font-weight="600" font-size="14" fill="#0F172A">Patient Waiting Lounge</text>
    <text x="60" y="44" font-family="'Inter', sans-serif" font-size="11" fill="#64748B">Air-Conditioned &amp; Peaceful</text>
  </g>
</svg>
