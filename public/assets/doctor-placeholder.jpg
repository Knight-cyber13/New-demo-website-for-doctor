<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 700" width="600" height="700">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#EFF6FF"/>
      <stop offset="50%" stop-color="#DBEAFE"/>
      <stop offset="100%" stop-color="#BFDBFE"/>
    </linearGradient>
    <linearGradient id="coatGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="100%" stop-color="#F1F5F9"/>
    </linearGradient>
    <linearGradient id="skinGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ECC695"/>
      <stop offset="100%" stop-color="#D9A873"/>
    </linearGradient>
  </defs>
  <rect width="600" height="700" fill="url(#bgGrad)"/>
  
  <!-- Subtle decorative medical cross background -->
  <g opacity="0.15" fill="#2563EB">
    <rect x="50" y="80" width="60" height="20" rx="4"/>
    <rect x="70" y="60" width="20" height="60" rx="4"/>
    <rect x="470" y="140" width="80" height="24" rx="6"/>
    <rect x="498" y="112" width="24" height="80" rx="6"/>
  </g>

  <!-- Doctor Silhouette / Illustration with White Coat & Stethoscope -->
  <!-- Shoulders & Torso (White Lab Coat) -->
  <path d="M120 700 L120 540 C120 450, 180 410, 240 400 L240 460 L300 520 L360 460 L360 400 C420 410, 480 450, 480 540 L480 700 Z" fill="url(#coatGrad)" filter="drop-shadow(0 10px 15px rgba(0,0,0,0.08))"/>
  
  <!-- Inner Blue Medical Shirt & Tie -->
  <polygon points="260,400 340,400 300,490" fill="#2563EB"/>
  <polygon points="290,400 310,400 305,480 300,485 295,480" fill="#1D4ED8"/>

  <!-- Lab Coat Lapels -->
  <polygon points="240,400 300,520 280,520 230,420" fill="#E2E8F0"/>
  <polygon points="360,400 300,520 320,520 370,420" fill="#E2E8F0"/>

  <!-- Neck -->
  <rect x="270" y="320" width="60" height="90" rx="10" fill="url(#skinGrad)"/>

  <!-- Head / Face -->
  <ellipse cx="300" cy="270" rx="75" ry="90" fill="url(#skinGrad)"/>

  <!-- Hair (Professional Short Crop) -->
  <path d="M220 250 C215 180, 260 160, 300 160 C340 160, 385 180, 380 250 C365 190, 340 180, 300 180 C260 180, 235 190, 220 250 Z" fill="#1E293B"/>

  <!-- Glasses -->
  <rect x="245" y="245" width="45" height="32" rx="8" fill="none" stroke="#1E293B" stroke-width="4"/>
  <rect x="310" y="245" width="45" height="32" rx="8" fill="none" stroke="#1E293B" stroke-width="4"/>
  <line x1="290" y1="260" x2="310" y2="260" stroke="#1E293B" stroke-width="4"/>
  <line x1="225" y1="255" x2="245" y2="258" stroke="#1E293B" stroke-width="3"/>
  <line x1="355" y1="258" x2="375" y2="255" stroke="#1E293B" stroke-width="3"/>

  <!-- Smile & Friendly Eyes -->
  <circle cx="268" cy="261" r="5" fill="#1E293B"/>
  <circle cx="332" cy="261" r="5" fill="#1E293B"/>
  <path d="M275 310 Q300 330 325 310" fill="none" stroke="#9A3412" stroke-width="4" stroke-linecap="round"/>

  <!-- Stethoscope around neck -->
  <path d="M225 430 C220 540, 270 560, 285 540 L285 570" fill="none" stroke="#334155" stroke-width="8" stroke-linecap="round"/>
  <path d="M375 430 C380 540, 330 560, 315 540" fill="none" stroke="#334155" stroke-width="8" stroke-linecap="round"/>
  <circle cx="285" cy="580" r="18" fill="#94A3B8" stroke="#334155" stroke-width="4"/>
  <circle cx="285" cy="580" r="10" fill="#2563EB"/>

  <!-- Verified Doctor Badge Overlay at bottom -->
  <g transform="translate(150, 610)">
    <rect width="300" height="60" rx="30" fill="#FFFFFF" filter="drop-shadow(0 10px 15px rgba(0,0,0,0.12))"/>
    <circle cx="36" cy="30" r="18" fill="#DCFCE7"/>
    <path d="M28 30 L34 36 L44 24" stroke="#16A34A" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    <text x="64" y="27" font-family="'Poppins', sans-serif" font-weight="700" font-size="14" fill="#0F172A">Dr. Rajesh Sharma</text>
    <text x="64" y="44" font-family="'Inter', sans-serif" font-weight="500" font-size="11" fill="#2563EB">Senior Physician (MBBS, MD)</text>
  </g>
</svg>
