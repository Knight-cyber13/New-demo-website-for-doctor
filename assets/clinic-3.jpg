<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="800" height="600">
  <defs>
    <linearGradient id="c3grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F1F5F9"/>
      <stop offset="100%" stop-color="#E2E8F0"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#c3grad)"/>
  <!-- Modern Building Exterior Glass Facade -->
  <rect x="150" y="100" width="500" height="420" rx="12" fill="#FFFFFF" stroke="#0F52BA" stroke-width="4"/>
  <!-- Clinic Signboard -->
  <rect x="200" y="140" width="400" height="90" rx="8" fill="#0284C7"/>
  <circle cx="250" cy="185" r="24" fill="#FFFFFF"/>
  <path d="M250 173 V197 M238 185 H262" stroke="#0284C7" stroke-width="5" stroke-linecap="round"/>
  <text x="290" y="180" font-family="'Poppins', sans-serif" font-weight="700" font-size="22" fill="#FFFFFF">AAROGYA CLINIC</text>
  <text x="290" y="202" font-family="'Inter', sans-serif" font-weight="500" font-size="12" fill="#E0F2FE">Family Healthcare & Diagnostics</text>
  <!-- Glass Double Doors -->
  <rect x="330" y="320" width="140" height="200" rx="4" fill="#E0F2FE" stroke="#64748B" stroke-width="3"/>
  <line x1="400" y1="320" x2="400" y2="520" stroke="#64748B" stroke-width="3"/>
  <rect x="385" y="420" width="6" height="30" rx="2" fill="#0F172A"/>
  <rect x="410" y="420" width="6" height="30" rx="2" fill="#0F172A"/>
  <!-- Exterior Badge -->
  <g transform="translate(480, 440)">
    <rect width="260" height="60" rx="30" fill="#FFFFFF" filter="drop-shadow(0 4px 8px rgba(0,0,0,0.1))"/>
    <circle cx="32" cy="30" r="18" fill="#DCFCE7"/>
    <path d="M25 30 L30 35 L40 24" stroke="#16A34A" stroke-width="3" fill="none"/>
    <text x="60" y="28" font-family="'Poppins', sans-serif" font-weight="600" font-size="13" fill="#0F172A">Easy Ground Floor Access</text>
    <text x="60" y="44" font-family="'Inter', sans-serif" font-size="11" fill="#64748B">Dedicated Patient Parking</text>
  </g>
</svg>
