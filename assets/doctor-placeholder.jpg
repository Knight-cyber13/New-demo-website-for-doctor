<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 700" width="600" height="700">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#EFF6FF"/>
      <stop offset="50%" stop-color="#DBEAFE"/>
      <stop offset="100%" stop-color="#BFDBFE"/>
    </linearGradient>
    <linearGradient id="coatGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="100%" stop-color="#F1F5F9"/>
    </linearGradient>
    <linearGradient id="skinGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ECC695"/>
      <stop offset="100%" stop-color="#D9A873"/>
    </linearGradient>
  </defs>
  <rect width="600" height="700" fill="url(#bgGrad)"/>
  
  <!-- Subtle decorative medical cross background -->
  <g opacity="0.15" fill="#0284C7">
    <rect x="50" y="80" width="60" height="20" rx="4"/>
    <rect x="70" y="60" width="20" height="60" rx="4"/>
    <rect x="470" y="140" width="80" height="24" rx="6"/>
    <rect x="498" y="112" width="24" height="80" rx="6"/>
  </g>
  
  <!-- Backdrop circle -->
  <circle cx="300" cy="350" r="230" fill="#E0F2FE" opacity="0.8"/>
  
  <!-- Doctor Body / Shoulders -->
  <path d="M120 700 C130 540, 200 480, 300 480 C400 480, 470 540, 480 700 Z" fill="url(#coatGrad)"/>
  <!-- Inner shirt -->
  <path d="M255 480 L300 560 L345 480 Z" fill="#0284C7"/>
  <polygon points="300,560 285,505 315,505" fill="#0369A1"/>
  <!-- Stethoscope -->
  <path d="M230 480 C230 570, 260 620, 290 630 L290 650" stroke="#334155" stroke-width="8" stroke-linecap="round" fill="none"/>
  <path d="M370 480 C370 570, 340 620, 310 630 L310 650" stroke="#334155" stroke-width="8" stroke-linecap="round" fill="none"/>
  <circle cx="300" cy="655" r="14" fill="#0284C7" stroke="#334155" stroke-width="4"/>
  <circle cx="300" cy="655" r="6" fill="#F8FAFC"/>
  
  <!-- Lab Coat Lapels -->
  <path d="M220 480 L260 640 L210 700 Z" fill="#F8FAFC" opacity="0.9"/>
  <path d="M380 480 L340 640 L390 700 Z" fill="#E2E8F0" opacity="0.9"/>

  <!-- Neck -->
  <rect x="270" y="380" width="60" height="80" rx="10" fill="url(#skinGrad)"/>
  
  <!-- Head & Face -->
  <ellipse cx="300" cy="310" rx="90" ry="110" fill="url(#skinGrad)"/>
  
  <!-- Professional Hair -->
  <path d="M210 300 C205 200, 270 170, 300 170 C350 170, 395 200, 390 300 C370 230, 340 210, 300 210 C260 210, 230 230, 210 300 Z" fill="#1E293B"/>
  
  <!-- Glasses -->
  <rect x="235" y="280" width="50" height="35" rx="10" fill="none" stroke="#0F172A" stroke-width="5"/>
  <rect x="315" y="280" width="50" height="35" rx="10" fill="none" stroke="#0F172A" stroke-width="5"/>
  <line x1="285" y1="295" x2="315" y2="295" stroke="#0F172A" stroke-width="5"/>
  <line x1="235" y1="290" x2="215" y2="280" stroke="#0F172A" stroke-width="4"/>
  <line x1="365" y1="290" x2="385" y2="280" stroke="#0F172A" stroke-width="4"/>
  
  <!-- Eyes -->
  <circle cx="260" cy="295" r="6" fill="#1E293B"/>
  <circle cx="340" cy="295" r="6" fill="#1E293B"/>
  
  <!-- Warm Friendly Smile -->
  <path d="M275 360 Q300 380 325 360" stroke="#8A4A28" stroke-width="4" stroke-linecap="round" fill="none"/>
  
  <!-- Badge Badge Overlay -->
  <g transform="translate(40, 560)">
    <rect width="210" height="70" rx="16" fill="#FFFFFF" filter="drop-shadow(0 10px 15px rgba(0,0,0,0.08))"/>
    <circle cx="36" cy="35" r="20" fill="#DCFCE7"/>
    <path d="M28 35 L33 40 L44 28" stroke="#16A34A" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    <text x="68" y="30" font-family="'Poppins', sans-serif" font-weight="700" font-size="14" fill="#0F172A">Dr. Rajesh Sharma</text>
    <text x="68" y="48" font-family="'Inter', sans-serif" font-weight="500" font-size="11" fill="#0284C7">MBBS, MD • 16+ Yrs Exp</text>
  </g>
</svg>
